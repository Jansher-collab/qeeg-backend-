# QEEG.com.au correlation platform — backend environment example
# Copy to .env and fill in real values. Do not commit real secrets.

# PostgreSQL connection string (Neon/Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Session signing secret — use a long random value in production
JWT_SECRET="change-me-to-a-long-random-secret"

# API port
PORT=5000

# Environment: development | production
NODE_ENV="development"

# Frontend origin (used for CORS + email links)
# FRONTEND_URL="https://qeeg-frontend.example.com"
FRONTEND_URL="http://localhost:3000"

# Postmark transactional email (all outbound mail is sent via Postmark)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
FROM_EMAIL=admin@qeeg.com.au
# POSTMARK_MESSAGE_STREAM=outbound       # defaults to the "outbound" stream
# EMAIL_FROM_NAME=QEEG Portal            # display name on the From header

# PayPal REST API — production credentials (always used when PAYPAL_MODE=live)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# PayPal sandbox credentials (used when PAYPAL_MODE=sandbox).
# Optional when only the production pair exists — sandbox falls back to
# PAYPAL_CLIENT_ID/PAYPAL_SECRET so you can spin up a mock locally.
PAYPAL_SANDBOX_CLIENT_ID=your-sandbox-client-id
PAYPAL_SANDBOX_SECRET=your-sandbox-secret

# sandbox (default) | live — must be "live" in production
PAYPAL_MODE=sandbox
PAYPAL_MERCHANT_EMAIL=your-merchant@business.example.com

# Admin bootstrap account (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Anthropic Claude (knowledge-base PDF extraction + grounded report synthesis).
# ANTHROPIC_MODEL must be a model currently available to your key (see
# https://docs.anthropic.com/en/docs/about-claude/models).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional NCBI E-utilities key (raises PubMed rate limits)
# NCBI_API_KEY=xxx

# Background worker + job-pipeline tuning (see lib/services/timeout.ts and
# reportProcessor.ts for defaults).
# WORKER_POLL_INTERVAL_MS=3000            # queue poll interval (ms)
# WORKER_MAX_ATTEMPTS=5                   # retries before a job is permanently failed
# REPORT_GENERATION_TIMEOUT_MS=180000     # budget for one correlation run (ms)
# REPORT_GENERATION_LOCK_STALE_MS=600000  # orphaned GENERATING reclaim threshold (ms)