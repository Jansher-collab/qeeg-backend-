{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/lib/backend/*": ["lib/*"],
      "@/lib/*": ["lib/*"],
      "@/generated/*": ["./generated/*"]
    }
  },
  "include": ["lib/**/*", "api/**/*", "generated/**/*", "prisma.config.ts", "server.ts"]
}